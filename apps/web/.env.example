# ── Base ──────────────────────────────────────────────────────
NEXT_PUBLIC_HOME_USERNAME=""
NEXT_PUBLIC_APP_TITLE="Kreads-APP"
DEV_ALLOWED_ORIGINS='[]' # 白名單
INVITE_LIMIT=3 # 一般使用者個人邀請碼可邀請人數，admin 不限
GUEST_POST_LIMIT=3 # 未登入訪客在個人頁最多看到的貼文數，看完會跳出登入牆
GUEST_CACHE_SECONDS=60 # 訪客共用的 GitHub 讀取快取秒數（最少 2），站長發文／編輯／刪除會立即清除
REACTION_EMOJI=heart # 按讚使用的 GitHub reaction：laugh、confused、heart、hooray、rocket、eyes

# ── Better Auth ──────────────────────────────────────────────────────
# 簽章與加密用的 secret。
# 開發環境沒設會 fallback 到內建預設值，production 沒設會直接 throw。
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL="http://localhost:3000" # Base URL of your app


# ── GitHub OAuth App（Stage 0.1）─────────────────────────────────────
# GitHub → Settings → Developer settings → OAuth Apps
# Authorization callback URL 填：
#   http://${BETTER_AUTH_URL}/api/auth/callback/github
#   （basePath 預設 /api/auth，加上 callback 端點 /callback/:id，
#     :id 就是 provider 名稱 github）
#
# 注意：better-auth 1.7.2 的內建 github provider 不會自動讀這兩個變數，
# 要在 auth 設定的 socialProviders.github 裡手動接上 process.env。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── GitHub 讀取 Token（選填）─────────────────────────────────────────
# 訪客（未登入）讀取貼文與留言時使用。沒設就不帶 token，
# 訪客共用同一個 IP 每小時 60 次的額度；設定後改用這個 token 的 5000 次／小時。
# GitHub → Settings → Developer settings → Personal access tokens → Fine-grained tokens
# Repository access 選 Public repositories (read-only)，不要給任何其他權限。
GITHUB_READ_TOKEN=

# ── DATABASE ───────────────────────────────────────────────
DATABASE_URL="postgresql://<user>:<password>@<endpoint_hostname>.neon.tech:<port>/<dbname>?sslmode=require&channel_binding=require"

# ── Dashboard ─────────────────────────────────────────────────
# 主站切換「公開／隱私」後通知後台清快取
DASHBOARD_URL="http://localhost:3001" # 後台網址
REVALIDATE_SECRET= # 跟後台同一組：openssl rand -hex 32