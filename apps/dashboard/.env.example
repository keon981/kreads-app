# ── Base ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_TITLE="Kreads Dashboard"

# ── Better Auth ──────────────────────────────────────────────
# 跟主站分開的一組 secret：openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# ── DATABASE ─────────────────────────────────────────────────
# 跟 apps/web 連同一個 DB
DATABASE_URL=

# ── Revalidate ───────────────────────────────────────────────
# 主站通知後台清快取時驗證用，跟 apps/web 同一組：openssl rand -hex 32
REVALIDATE_SECRET=
